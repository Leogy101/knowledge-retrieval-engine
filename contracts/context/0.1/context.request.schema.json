{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCB KRE local context request 0.1 feasibility subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "query", "access_scope_ref", "destination", "budget", "purpose"],
  "properties": {
    "contract_version": {"const": "0.1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "query": {"type": "string", "minLength": 1, "maxLength": 8192},
    "access_scope_ref": {"type": "string", "minLength": 1, "maxLength": 128},
    "destination": {"enum": ["local_only", "approved_remote"]},
    "purpose": {"enum": ["current_answer", "historical_evidence"]},
    "freshness_requirement": {"enum": ["allow_unknown", "fresh_only"]},
    "source_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tokens", "max_items", "max_bytes"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    }
  }
}
