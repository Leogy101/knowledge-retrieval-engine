+    def _neighbor_window(self, seed, covered):
+        """At most immediate neighbors, bounded by the existing chunk target.
+
+        This does not infer semantic completeness or change stored chunks.
+        """
+        neighbors = []
+        for direction, order in (("<", "DESC"), (">", "ASC")):
+            row = self.db.execute("SELECT * FROM chunks WHERE revision_id=? AND line_start " + direction +
+                                  " ? ORDER BY line_start " + order + " LIMIT 1",
+                                  (seed["revision_id"], seed["line_start"])).fetchone()
+            if row and row["id"] not in covered:
+                neighbors.append(row)
+        selected = [seed]
+        result = seed
+        for neighbor in neighbors:
+            trial = sorted([*selected, neighbor], key=lambda row: row["line_start"])
+            window = self._reference_row(seed["source_id"], seed["revision_id"],
+                                         f"w-{trial[0]['id']}-{trial[-1]['id']}")
+            if window:
+                result, selected = window, trial
+        return result, {row["id"] for row in selected}
